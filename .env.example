# Public site URL (used for canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL=https://anlytics.com

# Cal.com (or Calendly) booking URL embedded on /consulting and /contact.
# Leave empty to render the helpful "not configured" fallback instead of a broken iframe.
# Example: NEXT_PUBLIC_BOOKING_URL=https://cal.com/anlytics/30min
NEXT_PUBLIC_BOOKING_URL=

# Sanity CMS — see README "Sanity CMS setup". Create a free project at
# https://sanity.io/manage and paste the IDs below. When unset, /studio
# shows a setup screen and every page falls back to content/*.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-12-01

# Transactional email (Resend) — used by /api/contact, /api/newsletter, /api/applications
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@anlytics.com
